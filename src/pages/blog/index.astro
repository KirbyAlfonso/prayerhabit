---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<Base title="Blog" description="Practical guidance, historical meditations, and pastoral thoughts to deepen your daily fellowship with God.">
  <section class="page-head wrap">
    <p class="eyebrow">Read our latest posts</p>
    <h1>Reflections on the <em>prayerful life</em></h1>
    <p class="lead">Practical guidance, historical meditations, and pastoral thoughts to deepen your daily fellowship with God.</p>
  </section>
  <section class="narrow">
    {posts.map((p) => (
      <article class="post-card">
        {p.data.image && <img src={p.data.image} alt={p.data.imageAlt ?? ''} loading="lazy" />}
        <div>
          <p class="meta">{fmt(p.data.pubDate)}</p>
          <h3><a href={`/blog/${p.id}/`}>{p.data.title}</a></h3>
          <p>{p.data.description}</p>
        </div>
      </article>
    ))}
  </section>
</Base>
